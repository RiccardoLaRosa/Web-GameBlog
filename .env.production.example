# Modello per il server: copialo in .env e riempi i valori vuoti.
# Non inserire mai credenziali o dati personali in questo file, che viene salvato su git.

APP_NAME=GameBlog
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Senza / finale. Da qui dipendono gli indirizzi delle immagini.
APP_URL=https://tuodominio.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

# Titolare mostrato nella pagina Privacy Policy
PRIVACY_OWNER_NAME=
PRIVACY_OWNER_EMAIL=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Il registro giornaliero viene cancellato dopo 14 giorni: la Privacy Policy indica questa durata.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Deve restare debug: il mailer log scrive le email a questo livello e con un livello piu alto le scarterebbe.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Lascia true solo con HTTPS attivo, altrimenti il login non funziona.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# in locale smtp con Mailpit (127.0.0.1:1025), online log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Riceve una notifica a ogni nuova iscrizione.
MAIL_NOTIFICATION_ADDRESS=

VITE_APP_NAME="${APP_NAME}"
